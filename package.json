{
  "name": "bitcoinmints",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "biome check .",
    "format": "biome format --write .",
    "typecheck": "bun --filter='*' run typecheck",
    "test": "bun --filter='*' run test",
    "dev": "bun --filter='@bitcoinmints/app' run dev",
    "build": "bun --filter='@bitcoinmints/app' run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
